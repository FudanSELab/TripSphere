# TripSphere environment configuration
#
# Usage:
#   cp .env.example .env
#   Edit .env with your actual values, then start the stack with the Taskfile.
#
# Defaults assume all services run on the same Docker host.
# To point at an external machine, replace the Host value with its IP or hostname.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USERNAME=root
MONGODB_PASSWORD=changeme

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Nacos ─────────────────────────────────────────────────────────────────────
NACOS_HOST=nacos
NACOS_PORT=8848
# Credentials used by Go/Python clients to authenticate with Nacos
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# Server-side auth token (base64-encoded secret key, minimum 32 chars)
# Generate a new one for production: openssl rand -base64 32
NACOS_AUTH_TOKEN=VGhpc0lzTXlDdXN0b21TZWNyZXRLZXkwMTIzNDU2Nzg=

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_HOST=neo4j
NEO4J_PORT=7687
# Password for the built-in 'neo4j' user
NEO4J_PASSWORD=changeme

# ── RocketMQ ──────────────────────────────────────────────────────────────────
# Point at rmq-proxy (the gRPC proxy endpoint)
ROCKETMQ_HOST=rmq-proxy
ROCKETMQ_PORT=8081

# ── Higress / AI Gateway ──────────────────────────────────────────────────────
# After starting the stack, open the Higress console at http://<host>:8001
# and register your LLM provider (e.g. OpenAI, DeepSeek) with the real API key.
# Application services talk to Higress; they never see the actual API key.
#
# IMPORTANT: If you change HIGRESS_HOST, the OPENAI_BASE_URL in docker-compose.yaml
# is constructed as  http://${HIGRESS_HOST}:${HIGRESS_HTTP_PORT}/v1  so it will
# automatically reflect the change — no manual edit needed here.
HIGRESS_HOST=higress
HIGRESS_HTTP_PORT=8080
# Placeholder required by OpenAI-compatible SDK clients; the real key lives in Higress.
OPENAI_API_KEY=higress-managed

# ── Frontend ──────────────────────────────────────────────────────────────────
# RSA public key used by the Next.js frontend to verify JWTs issued by user-service.
# Paste the PEM-encoded public key here (wrap the entire value in double quotes).
JWT_PUBLIC_KEY=""

# ── Initializer (optional, one-shot data seeding) ────────────────────────────
# Required only when running infra/initializer to seed POI / attraction data.
AMAP_KEY=
